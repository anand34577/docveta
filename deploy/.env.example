# Copy to .env and fill in. Keep this file private and back it up.

# Docveta version to run (image tag), e.g. 0.2.0. Default: latest
DOCVETA_VERSION=

# Database password (any long random string)
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Encrypts stored secrets (SMTP/OIDC passwords). Leave empty and Docveta generates one
# on first start (saved in data/docveta.conf: back it up). Or set your own: openssl rand -hex 32
DOCVETA_SECRET_KEY=

# The URL people use to open Docveta (needed for links in emails and single sign-on).
DOCVETA_BASE_URL=http://localhost:8080

# If Docveta is behind a reverse proxy (Caddy, Traefik, Nginx), its IP/CIDR:
DOCVETA_TRUSTED_PROXIES=

# Allow notification channels (Gotify, ntfy, webhooks) on private network addresses,
# e.g. a Gotify server on your LAN. Off by default (protects your network from users).
DOCVETA_ALLOW_LOCAL_TARGETS=false

# Where data lives on the host (use SSD/NVMe/eMMC, not an SD card, for the database)
DOCVETA_DATA_DIR=./data
DOCVETA_DB_DIR=./db
DOCVETA_MODELS_DIR=./models

# Worker tokens from Administration → Processing → Add worker
DOCVETA_OCR_WORKER_TOKEN=
DOCVETA_NPU_WORKER_TOKEN=
DOCVETA_CPU_WORKER_TOKEN=
