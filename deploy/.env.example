# Optional settings for docker-compose.yml. Nothing here is required: Docveta generates its
# database password, secret key and engine tokens itself. Copy to .env to change something.

# Docveta version to run (image tag), e.g. 0.4.0. Default: latest
DOCVETA_VERSION=

# Port on this computer. Default: 8080
DOCVETA_PORT=

# The address people use to open Docveta, e.g. https://docs.example.com (used in email
# links and for single sign-on; https also enables secure cookies).
DOCVETA_BASE_URL=

# If Docveta is behind a reverse proxy (Caddy, Traefik, Nginx Proxy Manager), its IP/CIDR:
DOCVETA_TRUSTED_PROXIES=

# Allow notification channels (Gotify, ntfy, webhooks) on private network addresses,
# e.g. a Gotify server on your LAN. Off by default (protects your network from users).
DOCVETA_ALLOW_LOCAL_TARGETS=false

# Keep data in folders instead of Docker volumes (use SSD/NVMe/eMMC, not an SD card).
# A folder for DOCVETA_DATA_DIR must be owned by user 65532: sudo chown -R 65532:65532 ./data
DOCVETA_DATA_DIR=
DOCVETA_DB_DIR=
# Rockchip NPU models (npu-rockchip profile)
DOCVETA_MODELS_DIR=./models
